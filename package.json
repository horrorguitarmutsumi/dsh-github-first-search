{
  "name": "dsh-github-first-search",
  "description": "GitHub-first search for DeepSeek Harness — the agent searches GitHub before any web search (news included). Rust engine + thin JS shell.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horrorguitarmutsumi/dsh-github-first-search.git"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "github",
    "search",
    "rust"
  ],
  "scripts": {
    "build:engine": "cargo build --release --manifest-path engine/Cargo.toml",
    "test:engine": "cargo test --manifest-path engine/Cargo.toml",
    "install:engine": "node scripts/install-engine.mjs",
    "postinstall": "node scripts/install-engine.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run build",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.mjs\"",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.2 || ^0.1.3-alpha.2 || ^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.1-alpha.1 || ^0.2.1-rc.1 || ^0.2.2-alpha.2 || ^0.2.2-rc.1 || ^0.2.3-alpha.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
